{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/capture-prompt.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*fyreflock.*__fyreflock_(say|roost_say|game_move)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check-verbatim.mjs"
            ]
          }
        ]
      }
    ]
  },
  "modules": [
    "./mod.tsx"
  ]
}
